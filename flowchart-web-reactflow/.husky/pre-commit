#!/usr/bin/env sh
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
APP_DIR="$REPO_ROOT/flowchart-web-reactflow"

cd "$APP_DIR" || exit 1
npx lint-staged

STAGED=$(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACM | grep -E '^flowchart-web-reactflow/' || true)
if [ -n "$STAGED" ]; then
  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --hook-stage pre-commit --files $STAGED
  elif python -m pre_commit --version >/dev/null 2>&1; then
    python -m pre_commit run --hook-stage pre-commit --files $STAGED
  else
    echo "pre-commit not found. Install: pip install -e flowchart-web-reactflow/tools/excel_normalize[dev]" >&2
    exit 1
  fi
fi
